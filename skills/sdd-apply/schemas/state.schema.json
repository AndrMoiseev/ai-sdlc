{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDD execution manifest v2; semantic invariants are enforced by state.py",
  "type": "object",
  "required": ["schema_version", "change_id", "run_id", "revision", "status", "owner", "basis", "mode", "tasks", "roles", "event_head", "event_index", "blockers", "integrity"],
  "allOf": [{"if": {"required": ["work_kind"], "properties": {"work_kind": {"const": "refactoring"}}}, "then": {"required": ["acceptance", "verification"]}}],
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "kind"],
      "properties": {
        "path": {"type": "string", "pattern": "^objects/[0-9a-f]{2}/[0-9a-f]{64}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["object", "array", "string"]}
      }
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["$object"], "properties": {"$object": {"$ref": "#/$defs/reference"}}
    },
    "history": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "check_transition": {"anyOf": [{"$ref": "#/$defs/object"}, {
      "type": "object", "required": ["event_id", "registry_revision", "before", "after", "basis", "preserves", "reason", "mapping"],
      "properties": {
        "event_id": {"type": "string"}, "registry_revision": {"type": "integer", "minimum": 1},
        "before": {"anyOf": [{"type": "array", "minItems": 1}, {"$ref": "#/$defs/object"}]},
        "after": {"anyOf": [{"type": "array", "minItems": 1}, {"$ref": "#/$defs/object"}]},
        "reason": {"type": "string", "minLength": 1}
      }
    }]},
    "check_registry": {"anyOf": [{"$ref": "#/$defs/object"}, {
      "type": "object", "required": ["revision", "history"], "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "confirmed_revision": {"type": "integer", "minimum": 0},
        "confirmation_event": {"type": "string"},
        "transition": {"$ref": "#/$defs/check_transition"},
        "history": {"anyOf": [{"type": "array", "minItems": 1}, {"$ref": "#/$defs/object"}]}
      }
    }]}
  },
  "properties": {
    "schema_version": {"const": 2},
    "change_id": {"type": "string"},
    "work_kind": {"enum": ["change", "refactoring"]},
    "final_checks": {"anyOf": [{"$ref": "#/$defs/object"}, {"type": "object", "required": ["checks", "revision", "history", "evidence", "procedures", "failures"], "properties": {
      "revision": {"type": "integer", "minimum": 1}, "checks": {"anyOf": [{"type": "array"}, {"$ref": "#/$defs/object"}]},
      "failures": {"type": "object"}
    }}]},
    "run_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "owner": {"type": "string"},
    "status": {"enum": ["active", "blocked", "completed"]},
    "mode": {"enum": ["sequential", "parallel"]},
    "basis": {"type": "object"},
    "tasks": {"type": "object", "additionalProperties": {"type": "object", "properties": {
      "check_registry": {"$ref": "#/$defs/check_registry"}
    }}},
    "roles": {"type": "object"},
    "blockers": {"anyOf": [{"type": "array"}, {"$ref": "#/$defs/object"}]},
    "event_head": {"$ref": "#/$defs/history"},
    "event_index": {"$ref": "#/$defs/history"},
    "integrity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
