{
  "source_roots": ["app/src/main/kotlin"],
  "test_roots": ["app/src/test/kotlin"],
  "statistics_exclude_paths": ["**/build/**", ".gradle/**", "**/node_modules/**"],
  "exclude_paths": ["**/generated/**"],
  "package_prefixes": ["example"],
  "exclude_classes": ["example.generated.*"],
  "modules": {"orders": ["example.orders"], "pricing": ["example.pricing"]},
  "class_directories": ["app/build/classes/kotlin/main", "app/build/classes/java/main"],
  "scope": {"gradle_projects": [":app"], "source_sets": ["main"], "variant": "JVM", "test_tasks": [":app:test"]}
}
