+# /// script
+# requires-python = ">=3.11"
+# dependencies = []
+# ///
+"""Complete contract checks for alternate.add."""
+
+import sys
+sys.dont_write_bytecode = True
+
+import unittest
+from decimal import Decimal
+from fractions import Fraction
+from alternate import add
+
+
+class AddContract(unittest.TestCase):
+    def test_numeric_values_and_types(self):
+        for a, b, expected, kind in [
+            (2, 3, 5, int), (-7, 3, -4, int), (0, 0, 0, int),
+            (1.5, 2.25, 3.75, float), (2, 0.5, 2.5, float),
+            (0.5, 2, 2.5, float), (-1.5, 1.5, 0.0, float),
+            (10**1000, 10**1000, 2 * 10**1000, int),
+            (10**1000, -(10**1000), 0, int),
+        ]:
+            with self.subTest(a=a, b=b):
+                result = add(a, b)
+                self.assertEqual(result, expected)
+                self.assertIs(type(result), kind)
+
+    def test_invalid_types_in_both_positions(self):
+        for value in [True, False, "2", None, [], {}, object(), 1j,
+                      Decimal("2"), Fraction(1, 2)]:
+            for a, b in [(value, 1), (1, value)]:
+                with self.subTest(a=a, b=b):
+                    with self.assertRaises(TypeError):
+                        add(a, b)
+
+    def test_nonfinite_operands_in_both_positions(self):
+        for value in [float("inf"), float("-inf"), float("nan")]:
+            for a, b in [(value, 1), (1, value)]:
+                with self.subTest(a=a, b=b):
+                    with self.assertRaises(ValueError):
+                        add(a, b)
+
+    def test_nonfinite_results_and_conversion_overflow(self):
+        for a, b in [(1e308, 1e308), (-1e308, -1e308),
+                     (10**1000, 0.5), (0.5, 10**1000)]:
+            with self.subTest(a=a, b=b):
+                with self.assertRaises(ValueError):
+                    add(a, b)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
