\u0438 \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c \\u0440\\u0430\\u0437\\u0431\\u043e\\u0440\\u0435 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439 \\u043f\\u0440\\u0435\\u0436\\u043d\\u0438\\u0435 \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b; \\u043f\\u0440\\u0438 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f\\u0445 \\u043f\\u0435\\u0440\\u0435\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438 \\u0437\\u0430\\u0442\\u0440\\u043e\\u043d\\u0443\\u0442\\u0443\\u044e \\u0447\\u0430\\u0441\\u0442\\u044c. \\u041e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0443\\u044e \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c, \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u0439 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442 \\u0438\\u043b\\u0438 \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0439 \\u043f\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\\u043c \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u0438\\u043a\\u0430.\\n4. \\u041f\\u0440\\u0438 \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0435\\u043c/\\u043f\\u043e\\u0432\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u043d\\u043e\\u043c state \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b \\u0438 \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438 \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u043e\\u0439 checkpoint \\u0438\\u0437 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432 \\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0439. \\u041d\\u0435 \\u043f\\u043e\\u0432\\u0442\\u04