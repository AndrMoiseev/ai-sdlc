0430\\u044f \\u0447\\u0430\\u0441\\u0442\\u044c \\u0445\\u0440\\u0430\\u043d\\u0438\\u0442 \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0439 \\u0448\\u0430\\u0433, \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044f, \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f-\\u0441\\u0441\\u044b\\u043b\\u043a\\u0438 \\u0438 \\u0441\\u043e\\u0441\\u0442\\u043e\\u044f\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043e\\u043a, \\u0431\\u0435\\u0437 \\u0434\\u0443\\u0431\\u043b\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f specs/design.\\n\\n\\u041f\\u043e\\u0432\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u043d\\u044b\\u0439 state \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u043a\\u0430\\u043a \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a \\u043f\\u043e \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u043c \\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u043c \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u044b\\u043c \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f\\u043c. Phase \\u043d\\u0435 \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0430\\u0435\\u0442 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f. \\u041e\\u0442\\u043c\\u0435\\u043d\\u0430 \\u0438\\u043b\\u0438 \\u0437\\u0430\\u043c\\u0435\\u043d\\u0430 \\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043d\\u0438\\u043c \\u043e\\u0442\\u0432\\u0435\\u0442\\u043e\\u043c \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043f\\u0440\\u0435\\u043a\\u0440\\u0430\\u0449\\u0430\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0440\\u043e\\u0435 \\u043f\\u043e\\u0440\\u0443\\u0447\\u0435\\u043d\\u0438\\u0435; \\u043d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 tasks \\u043d\\u0435 \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u04