430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044c. \\u041a\\u043e\\u043d\\u0442\\u0440\\u0430\\u043a\\u0442 \\u043c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0438 \\u043e\\u0431\\u043d\\u0430\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f \\u043e\\u043f\\u0438\\u0441\\u0430\\u043d \\u0432 [OpenAI Build skills](https://learn.chatgpt.com/docs/build-skills).\\n\\n\\u0414\\u043b\\u044f \\u043a\\u0430\\u0436\\u0434\\u043e\\u0433\\u043e \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0433\\u043e \\u0440\\u0435\\u0446\\u0435\\u043d\\u0437\\u0435\\u043d\\u0442\\u0430 \\u0441\\u043e\\u0437\\u0434\\u0430\\u0439 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442. \\u0415\\u0441\\u043b\\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u0439 API \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 `fork_turns`, \\u043f\\u0435\\u0440\\u0435\\u0434\\u0430\\u0439 `fork_turns: \\\"none\\\"`; \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043d\\u0430\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u044c \\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u044e. \\u041f\\u0435\\u0440\\u0435\\u0434\\u0430\\u0439 \\u043f\\u043e\\u0434\\u0433\\u043e\\u0442\\u043e\\u0432\\u043b\\u0435\\u043d\\u043d\\u043e\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u0435 \\u0438 \\u043f\\u0443\\u0442\\u0438 \\u043d\\u0430\\u043f\\u0440\\u044f\\u043c\\u0443\\u044e. \\u041d\\u0435 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439 \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 fork \\u0430\\u0432\\u0442\\u043e\\u0440\\u0441\\u043a\\u043e\\u0439 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438. \\u0412 \\u0434\\u0440\\u0443\\u0433\\u043e\\u043c \\u0438\\u043d\\u0442\\u0435\\u0440\\u0444\\u0435\\u0439\\u0441\\u0435 \\u0441\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044c \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431 \\u0438\\u0437\\u043e\\u043b\\u044f\\u0446\\u0438\\u0438, \\u0430 \\u043d\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u0430\\u0433\\u0430\\u0435\\u043c\\u044b\\u0439 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440. \\u041d\\u0430\\u0441\\u0442\\u0440\\u043e\\u0439\\u043a\\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0430\\u0433\\u0435\\u043d\\u0442\\u043e\\u0432 \\u043e\\u043f\\u0438\\u0441\\u0430\\u043d\\u044b \\u0432 [OpenAI Subagents](https://learn.chatgpt.com/docs/agent-configuration/subagents).\\n\\n\\u0412\\u043a\\u043b\\u044e\\u0447\\u0430\\u0439 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u0439 read-only sandbox/\\u043d\\u0430\\u0431\\u043e\\u0440 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432. \\u0412 \\u0442\\u0435\\u0445\\u043d\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u043c `codex-cli 0.159.0` \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 `codex exec --help` \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 `--sandbox read-only`, `--ephemeral`, `--cd`, \\u0447\\u0442\\u0435\\u043d\\u0438\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u044f \\u0438\\u0437 stdin. \\u041d\\u043e\\u0432\\u044b\\u0439 `codex exec --sandbox read-only --ephemeral --cd <repo> -` \\u0434\\u043e\\u043f\\u0443\\u0441\\u0442\\u0438\\u043c \\u043a\\u0430\\u043a \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441 \\u043f\\u0440\\u0438 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u043d\\u043e\\u043c \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0435 \\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0439 \\u0430\\u0443\\u04