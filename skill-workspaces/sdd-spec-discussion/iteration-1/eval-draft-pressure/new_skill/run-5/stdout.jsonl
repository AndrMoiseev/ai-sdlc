433\\u0430\\u0435\\u0442, \\u0440\\u0438\\u0441\\u0443\\u0439 \\u0435\\u0435; \\u0434\\u043b\\u044f \\u0432\\u044b\\u0440\\u043e\\u0432\\u043d\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u0432\\u044b\\u0445 \\u0441\\u0445\\u0435\\u043c \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439 ASCII.\\n\\n1. \\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0435 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f \\u0438 \\u0440\\u0435\\u043b\\u0435\\u0432\\u0430\\u043d\\u0442\\u043d\\u044b\\u0435 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0438 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430. \\u0414\\u043e \\u0444\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u0430 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u0443\\u0439 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u0438\\u043a\\u0438, \\u0442\\u0435\\u0441\\u0442\\u044b, \\u043a\\u043e\\u043d\\u0444\\u0438\\u0433\\u0443\\u0440\\u0430\\u0446\\u0438\\u044e \\u0438 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u0446\\u0438\\u044e. \\u0421\\u043e\\u043e\\u0431\\u0449\\u0438 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0432\\u044b\\u0432\\u043e\\u0434 \\u0441\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0430\\u043c\\u0438. \\u041f\\u0440\\u0438 \\u043a\\u043e\\u043d\\u0444\\u043b\\u0438\\u043a\\u0442\\u0435 \\u0438\\u043b\\u0438 \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a\\u043e\\u0432 \\u043e\\u0431\\u043e\\u0437\\u043d\\u0430\\u0447\\u044c \\u043e\\u0433\\u0440\\u0430\\u043d\\u0438\\u0447\\u0435\\u043d\\u0438\\u0435; \\u043d\\u0435 \\u0437\\u0430\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0439 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u044f\\u0442\\u044c \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u043c\\u044b\\u0439 \\u0444\\u0430\\u043a\\u0442.\\n2. \\u041f\\u043e\\u0441\\u043b\\u0435 \\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0446\\u0435\\u043b\\u0438 \\u0438 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442\\u0430 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438 \\u043a\\u043e\\u0440\\u043e\\u0442\\u043a\\u0438\\u0439 [\\u043f\\u0440\\u0435\\u043c\\u043e\\u0440\\u0442\\u0435\\u043c](../references/premortem.md) \\u0438\\u043b\\u0438 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439 \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0451\\u043d\\u043d\\u044b\\u0439 \\u0440\\u0430\\u0437\\u0431\\u043e\\u0440. \\u0421\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 \\u0438\\u0442\\u043e\\u0433 \\u0434\\u043e \\u043f\\u0435\\u0440\\u0435\\u0445\\u043e\\u0434\\u0430 \\u043a \\u043f\\u043e\\u0434\\u0440\\u043e\\u0431\\u043d\\u043e\\u0439 \\u0441\\u043f\\u0435\\u0446\\u0438\\u0444\\u0438\\u043a\\u0430\\u0446\\u0438\\u0438; \\u0432\\u043e\\u0437\\u043d\\u0438\\u043a\\u0430\\u044e\\u0449\\u0438\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0439 \\u043f\\u043e \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u043c \\u0448\\u0430\\u0433\\u0430\\u043c.\\n3. \\u0412\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438 [\\u0446\\u0438\\u043a\\u043b \\u043e\\u0431\\u0441\\u0443\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f](../references/discussion.md): \\u043e\\u0442\\u0434\\u0435\\u043b\\u0438 \\u0444\\u0430\\u043a\\u0442\\u044b \\u043e\\u0442 \\u0441\\u0443\\u0449\\u0435