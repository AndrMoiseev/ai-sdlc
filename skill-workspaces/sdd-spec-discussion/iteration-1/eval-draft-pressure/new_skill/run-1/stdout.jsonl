\u0438\\u0435 \\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043d\\u0430\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u044c \\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u044e. \\u041f\\u0435\\u0440\\u0435\\u0434\\u0430\\u0439 \\u043f\\u043e\\u0434\\u0433\\u043e\\u0442\\u043e\\u0432\\u043b\\u0435\\u043d\\u043d\\u043e\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u0435 \\u0438 \\u043f\\u0443\\u0442\\u0438 \\u043d\\u0430\\u043f\\u0440\\u044f\\u043c\\u0443\\u044e. \\u041d\\u0435 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439 \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 fork \\u0430\\u0432\\u0442\\u043e\\u0440\\u0441\\u043a\\u043e\\u0439 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438. \\u0412 \\u0434\\u0440\\u0443\\u0433\\u043e\\u043c \\u0438\\u043d\\u0442\\u0435\\u0440\\u0444\\u0435\\u0439\\u0441\\u0435 \\u0441\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044c \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431 \\u0438\\u0437\\u043e\\u043b\\u044f\\u0446\\u0438\\u0438, \\u0430 \\u043d\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u0430\\u0433\\u0430\\u0435\\u043c\\u044b\\u0439 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440. \\u041d\\u0430\\u0441\\u0442\\u0440\\u043e\\u0439\\u043a\\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0430\\u0433\\u0435\\u043d\\u0442\\u043e\\u0432 \\u043e\\u043f\\u0438\\u0441\\u0430\\u043d\\u044b \\u0432 [OpenAI Subagents](https://learn.chatgpt.com/docs/agent-configuration/subagents).\\n\\n\\u0412\\u043a\\u043b\\u044e\\u0447\\u0430\\u0439 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u0439 read-only sandbox/\\u043d\\u0430\\u0431\\u043e\\u0440 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432. \\u0412 \\u0442\\u0435\\u0445\\u043d\\u0438\\u0447\\u0435\\u0441\\u043a\\u04