449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0432\\u044b\\u0431\\u043e\\u0440\\u043e\\u0432, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u044f \\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044f. \\u0421\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 \\u0438\\u0445 \\u0430\\u0432\\u0442\\u043e\\u0440\\u0441\\u0442\\u0432\\u043e \\u0438 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432 decisions.md, \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u2014 \\u0432 questions.md. \\u041d\\u0430\\u0447\\u043d\\u0438 \\u0441 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430 \\u0438 \\u0433\\u0440\\u0430\\u043d\\u0438\\u0446 \\u0434\\u043e API \\u0438 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445; \\u043f\\u0440\\u0438 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0438 \\u0440\\u0430\\u043d\\u043d\\u0435\\u0433\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u044b\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044f.\\n4. \\u0417\\u0430\\u0434\\u0430\\u0439 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u0441\\u0444\\u043e\\u043a\\u0443\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441 \\u0441 \\u043f\\u0440\\u0438\\u0447\\u0438\\u043d\\u043e\\u0439, \\u0440\\u0435\\u043a\\u043e\\u043c\\u0435\\u043d\\u0434\\u0430\\u0446\\u0438\\u0435\\u0439 \\u0438 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u043c\\u0438 \\u043a\\u043e\\u043c\\u043f\\u0440\\u043e\\u043c\\u0438\\u0441\\u0441\\u0430\\u043c\\u0438. \\u041f\\u043e\\u0441\\u043b\\u0435 \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430 \\u043e\\u0431\\u043d\\u043e\\u0432\\u0438 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b \\u0438 \\u043e\\u0447\\u0435\\u0440\\u0435\\u0434\\u044c. \\u0417\\u0430\\u0432\\u0435\\u0440\\u0448\\u0438 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u043f\\u043e \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u043c discussion, \\u0430 \\u043d\\u0435 \\u043f\\u043e \\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e\\u0439 \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0438\\u043b\\u0438 \\u0447\\u0438\\u0441\\u043b\\u0443 \\u0437\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u043e\\u0432. \\u041f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0441\\u0434\\u0435\\u043b\\u0430\\u0442\\u044c \\u043f\\u0430\\u0443\\u0437\\u0443, \\u0441\\u043c\\u0435\\u043d\\u0438\\u0442\\u044c \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 \\u043e\\u0442\\u043b\\u043e\\u0436\\u0438\\u0442\\u044c \\u043e\\u0431\\u0441\\u0443\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435.\\n5. \\u041f\\u043e\\u0441\\u043b\\u0435 \\u0441\\u043c\\u044b\\u0441\\u043b\\u043e\\u0432\\u043e\\u0433\\u043e \\u044d\\u0442\\u0430\\u043f\\u0430 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u0439 [checkpoint](resume.md) \\u0441\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u0430\\u043c\\u0438 \\u043d\\u0430 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u0438 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f. \\u041d\\u0435\\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0451\\u043d\\u043d\\u044b\\u0439 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u043e\\u0441\\u0442\\u0430\\u0451\\u0442\\u0441\\u044f \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u044e\\u0449\\u0438\\u043c; \\u043d\\u0435\\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u044e\\u0449\\u0430\\u044f \\u043e\\u0442\\u0441\\u0440\\u043e\\u0447\\u043a\\u0430 \\u0438\\u043c\\u0435\\u0435\\u0442 \\u043f\\u0440\\u0438\\u0447\\u0438\\u043d\\u0443 \\u0438 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 `return_at`.\\n6. \\u0415\\u0441\\u043b\\u0438 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u0445\\u043e\\u0447\\u0435\\u0442 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b, \\u043f\\u0435\\u0440\\u0435\\u0445\\u043e\\u0434\\u0438 \\u043a [draft](draft.md); \\u0435\\u0441\\u043b\\u0438 \\u043f\\u0440\\u0430\\u0432\\u043a\\u0443 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0445 \\u2014 \\u043a [revise](revise.md). \\u041f\\u043e\\u0441\\u043b\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u044f \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a\\u0430 \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0438 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u043f\\u043e discussion. \\u041f\\u0440\\u0438 \\u043f\\u0430\\u0443\\u0437\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 \\u043e\\u0447\\u0435\\u0440\\u0435\\u0434\\u044c \\u0438 \\u0442\\u043e\\u0447\\u043a\\u0443 \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0435\\u043d\\u0438\\u044f. \\u041d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432 \\u043d\\u0435 \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442 \\u0433\\u043e\\u0442\\u043e\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a \\u0440\\u0435\\u0432\\u044c\\u044e.\\n\\n\\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u0438\\u044f: \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u044b\\u0435 \\u0444\\u0430\\u043a\\u0442\\u044b \\u0438\\u0437\\u0443\\u0447\\u0435\\u043d\\u044b, \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440 \\u043f\\u043e\\u043d\\u044f\\u0442\\u0435\\u043d, \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044f \\u043d\\u0435 \\u043d\\u0430\\u0437\\u0432\\u0430\\u043d\\u044b \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f\\u043c\\u0438, checkpoint \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d. \\u042d\\u0442\\u043e\\u0442 \\u0444\\u043b\\u043e\\u0443 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u0443\\u0435\\u0442 \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043f\\u043b\\u0430\\u043d\\u043e\\u0432\\u044b\\u0435 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b; \\u043a\\u043e\\u0434 \\u0438 \\u043a\\u043e\\u043d\\u0444\\u0438\\u0433\\u0443\\u0440\\u0430\\u0446\\u0438\\u044e \\u043f\\u0440\\u043e\\u0434\\u0443\\u043a\\u0442\\u0430 \\u043d\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u044f\\u0439.\\n\"}\r\n","exit_code":0,"status":"completed"}}
