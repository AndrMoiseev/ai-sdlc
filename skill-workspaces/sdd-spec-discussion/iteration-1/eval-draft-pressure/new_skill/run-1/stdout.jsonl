\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u043d\\u0438\\u0438 \\u0441\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u043e\\u0439 \\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u043c \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438. \\u0421\\u043a\\u0440\\u0438\\u043f\\u0442 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442\\n\\u0444\\u0430\\u0439\\u043b \\u0438 \\u0444\\u043e\\u0440\\u043c\\u0443 \\u0441\\u0441\\u044b\\u043b\\u043a\\u0438; \\u043d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 \\u044f\\u043a\\u043e\\u0440\\u044f \\u0438 \\u0441\\u043c\\u044b\\u0441\\u043b \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 \\u0430\\u0433\\u0435\\u043d\\u0442.\\n\\u0423 legacy-\\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u043e\\u0432 \\u0432 state resolution \\u043d\\u0435\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d. \\u0414\\u0443\\u0431\\u043b\\u0438\\u043a\\u0430\\u0442 Q-ID \\u043c\\u0435\\u0436\\u0434\\u0443\\nquestions.md \\u0438 state \\u2014 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u044f \\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0430\\u044e\\u0449\\u0438\\u0435 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438.\\n\\u041f\\u0435\\u0440\\u0435\\u043d\\u043e\\u0441 \\u0438 \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u044f\\u0439 \\u043f\\u043e [discussion](discussion.md).\\n\\n## \\u041b\\u0438\\u043d\\u0437\\u044b, \\u043e\\u0442\\u0447\\u0435\\u0442\\u044b \\u0438 \\u0441\\u0432\\u043e\\u0434\\u043a\\u0430\\n\\n\\u0418\\u043d\\u0434\\u0435\\u043a\\u0441 `sdd/arch-lenses/index.md`: frontmatter `schema_version: 1`, `lenses: [{id, title, path}]`. \\u041f\\u0443\\u0442\\u0438 \\u043e\\u0442\\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433\\u0430 \\u0438\\u043d\\u0434\\u0435\\u043a\\u0441\\u0430. \\u041d\\u0435\\u0442 \\u0444\\u0430\\u0439\\u043b\\u0430 \\u0438\\u043b\\u0438 lenses: [] \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e consistency; \\u043f\\u043e\\u0432\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0439 \\u0438\\u043d\\u0434\\u0435\\u043a\\u0441 \\u043e\\u0448\\u0438\\u0431\\u043e\\u0447\\u0435\\u043d. consistency \\u0438 plan \\u0437\\u0430\\u0440\\u0435\\u0437\\u0435\\u0440\\u0432\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u044b. \\u0421\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u043c\\u043e\\u0435 \\u043b\\u0438\\u043d\\u0437\\u044b: \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442, \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b, \\u043e\\u0433\\u0440\\u0430\\u043d\\u0438\\u0447\\u0435\\u043d\\u0438\\u044f, \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a\\u0438.\\n\\n\\u041e\\u0442\\u0447\\u0435\\u0442: `review/<run-id>/<lens-id>.md`; \\u0434\\u043b\\u044f \\u043f\\u043b\\u0430\\u043d\\u0430 lens-id=plan. Run-id \\u2014 UTC-\\u0432\\u0440\\u0435\\u043c\\u044f \\u0441 \\u0443\\u043d\\u0438\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u043c \\u0441\\u0443\\u0444\\u0444\\u0438\\u043a\\u0441\\u043e\\u043c. \\u0414\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 frontmatter: run_id, stage (document_review/plan_review), lens_id, result, started_at, finished_at, inputs, inputs_after, freshness, limitations. \\u0412\\u0441\\u0435 \\u0434\\u0430\\u0442\\u044b \\u0437\\u0430\\u043a\\u043b\\u044e\\u0447\\u0430\\u0439\\u0442\\u0435 \\u0432 \\u043a\\u0430\\u0432\\u044b\\u0447\\u043a\\u0438. result: completed_no_findings/completed_with_findings/incomplete; limitations \\u2014 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0441\\u0442\\u0440\\u043e\\u043a. \\u041d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0430 \\u0438\\u043c\\u0435\\u0435\\u0442 source (\\u0442\\u0435\\u043a\\u0441\\u0442), target: {path, element_id?}, severity: blocker/recommendation, problem/impact/suggestion (\\u043d\\u0435\\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u0442\\u0435\\u043a\\u0441\\u0442). target.path \\u043e\\u0442\\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f.\\n\\n\\u041c\\u0430\\u043d\\u0438\\u0444\\u0435\\u0441\\u0442 \\u2014 \\u043e\\u0442\\u0441\\u043e\\u0440\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a `{path, sha256}`; \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442\\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f, \\u0445\\u0435\\u0448\\u0438 SHA-256 \\u0441\\u044b\\u0440\\u044b\\u0445 \\u0431\\u0430\\u0439\\u0442\\u043e\\u0432. \\u0414\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043d\\u0430\\u044f \\u0441\\u0442\\u0430\\u0434\\u0438\\u044f \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442 proposal/design/\\u0432\\u0441\\u0435 specs/**/spec.md; \\u043f\\u043b\\u0430\\u043d\\u043e\\u0432\\u0430\\u044f \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 tasks. State, decisions.md, questions.md, review, premortem.md, \\u0432\\u043d\\u0435\\u0448\\u043d\\u0438\\u0435 \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a\\u0438 \\u0438 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0438 \\u043b\\u0438\\u043d\\u0437 \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u044b. \\u0421\\u043d\\u0438\\u043c\\u043e\\u043a \\u0434\\u043e/\\u043f\\u043e\\u0441\\u043b\\u0435 \\u0438 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0438\\u0439 \\u0434\\u043e\\u043b\\u0436\\u043d\\u044b \\u0441\\u043e\\u0432\\u043f\\u0430\\u0441\\u0442\\u044c; \\u0433\\u043e\\u043d\\u043a\\u0430 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u