ding/in_progress/done/blocked; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043f\\u043b\\u0430\\u043d \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0435\\u0442 \\u0441 pending. \\u041f\\u0440\\u043e\\u0433\\u0440\\u0435\\u0441\\u0441 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043a\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e\\u043c done, \\u043d\\u0435 \\u043c\\u0430\\u043a\\u0441\\u0438\\u043c\\u0430\\u043b\\u044c\\u043d\\u044b\\u043c \\u043d\\u043e\\u043c\\u0435\\u0440\\u043e\\u043c; \\u0441\\u0442\\u0430\\u0442\\u0443\\u0441 \\u043d\\u0435 \\u0434\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u0442\\u0435\\u0441\\u0442\\u043e\\u0432. \\u041f\\u0438\\u043b\\u043e\\u0442 \\u043d\\u0435 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u044f\\u0435\\u0442 \\u043f\\u043b\\u0430\\u043d.\\n\\n`verification` \\u2014 \\u043d\\u0435\\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442\\u043e\\u0432 `criteria`, `test_description`, `location`, `run`. criteria \\u2014 \\u043d\\u0435\\u043f\\u0443\\u0441\\u0442\\u043e\\u0435 \\u043f\\u043e\\u0434\\u043c\\u043d\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u043e covers; \\u043e\\u0431\\u044a\\u0435\\u0434\\u0438\\u043d\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0432\\u0441\\u0435 covers. run \\u2014 mapping \\u0440\\u043e\\u0432\\u043d\\u043e \\u0441 \\u043e\\u0434\\u043d\\u0438\\u043c \\u043a\\u043b\\u044e\\u0447\\u043e\\u043c command, procedure \\u0438\\u043b\\u0438 setup_required \\u0438 \\u043d\\u0435\\u043f\\u0443\\u0441\\u0442\\u044b\\u043c \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u043c. command \\u2014 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u043d\\u0430\\u044f \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430; procedure \\u2014 \\u0441\\u0441\\u0