u044f\\u0439\\u0441\\u044f \\u043f\\u0435\\u0440\\u0438\\u043e\\u0434\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438.\\n\\n\\u041f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0435\\u043d\\u0438\\u044f: \\u00ab`$sdd-spec` (Codex) \\u0438\\u043b\\u0438 `/sdd-spec` (Claude Code), \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0438 `<change-id>` \\u0432 `<repo>`; \\u043f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 state.md, decisions.md, questions.md, \\u043d\\u043e\\u0440\\u043c\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0435 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b \\u0438 review/decisions.md \\u0432 \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433\\u0435 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f; \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044c \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0439 \\u0438 \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0438 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439 \\u0432\\u044b\\u0431\\u043e\\u0440, \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044f \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0435 \\u043f\\u043e\\u0440\\u0443\\u0447\\u0435\\u043d\\u0438\\u044f\\u00bb. \\u041e\\u043d \\u0443\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043d\\u0430 \\u0444\\u0430\\u0439\\u043b\\u044b, \\u0430 \\u043d\\u0435 \\u0437\\u0430\\u043c\\u0435\\u043d\\u044f\\u0435\\u0442 \\u0438\\u0445.\\n\", \"references/codex.md\": \"# \\u0410\\u0434\\u0430\\u043f\\u0442\\u0435\\u0440 Codex\\n\\n\\u042f\\u0432\\u043d\\u044b\\u0439 \\u0432\\u0445\\u043e\\u0434 \\u2014 `$sdd-spec` \\u043b\\u0438\\u0431\\u043e \\u0432\\u044b\\u0431\\u043e\\u0440 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430. \\u