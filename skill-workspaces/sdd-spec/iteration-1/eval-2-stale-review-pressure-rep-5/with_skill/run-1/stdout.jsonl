432\\u043b\\u044f\\u0435\\u0442 \\u043c\\u0435\\u0442\\u0440\\u0438\\u043a\\u0443, \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439 \\u0441\\u043c\\u044b\\u0441\\u043b\\u043e\\u0432\\u044b\\u0435 checkpoints \\u0438 \\u0447\\u0435\\u0441\\u0442\\u043d\\u043e \\u0443\\u043a\\u0430\\u0436\\u0438 \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0438\\u0435 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u044f. \\u0423\\u043d\\u0438\\u0432\\u0435\\u0440\\u0441\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 hook \\u0438\\u043b\\u0438 \\u0432\\u044b\\u0447\\u0438\\u0441\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u0446\\u0435\\u043d\\u0442\\u0430 \\u043f\\u043e \\u0434\\u043b\\u0438\\u043d\\u0435 \\u043f\\u0435\\u0440\\u0435\\u043f\\u0438\\u0441\\u043a\\u0438 \\u043d\\u0435 \\u043f\\u0440\\u0435\\u0434\\u043f\\u043e\\u043b\\u0430\\u0433\\u0430\\u0435\\u0442\\u0441\\u044f. \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u0438 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u043f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0435\\u043d\\u0438\\u044f \\u2014 \\u0432 [resume](../flows/resume.md).\\n\\n\\u0422\\u0435\\u0445\\u043d\\u0438\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0441\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0438 \\u0438 CLI \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u0430 2026-09-29; \\u0441\\u043f\\u0440\\u0430\\u0432\\u043a\\u0430 \\u0432\\u0435\\u0440\\u043d\\u0443\\u043b\\u0430 \\u043f\\u0440\\u0435\\u0434\\u0443\\u043f\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u043e \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0439 \\u043e\\u0447\\u0438\\u0441\\u0442\\u043a\\u0435 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e PATH-\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433\\u0430, \\u043d\\u043e \\u0432\\u0435\\u0440\\u0441\\u0438\\u044f \\u0438 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u0