 \\u0438\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0438\\u043e\\u043d\\u043d\\u043e\\u0439 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0435\\u0439. \\u041d\\u043e\\u0432\\u043e\\u0435 \\u043f\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0441\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0443\\u0439 \\u0432 specs/AC.\\n3. \\u0417\\u0430\\u0434\\u0430\\u0439 `depends_on` \\u043f\\u043e TASK-ID, \\u043d\\u0435 \\u043d\\u043e\\u043c\\u0435\\u0440\\u0443. \\u041d\\u043e\\u043c\\u0435\\u0440 \\u043c\\u043e\\u0436\\u043d\\u043e \\u043c\\u0435\\u043d\\u044f\\u0442\\u044c \\u043f\\u0440\\u0438 \\u043f\\u0435\\u0440\\u0435\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043a\\u0435; \\u0438\\u0434\\u0435\\u043d\\u0442\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c \\u0438 \\u0441\\u0441\\u044b\\u043b\\u043a\\u0438 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f. \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044c \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0435 \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438, self-reference \\u0438 \\u0446\\u0438\\u043a\\u043b\\u044b. \\u0413\\u0440\\u0430\\u0444 \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043d\\u043e \\u043e\\u0431\\u0449\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b/\\u043a\\u043e\\u043d\\u0442\\u0440\\u0430\\u043a\\u0442\\u044b \\u0442\\u0440\\u0435\\u0431\\u0443\\u044e\\u0442 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e\\u0439 \\u043e\\u0446\\u0435\\u043d\\u043a\\u0438 \\u0431\\u0435\\u0437\\u043e\\u043f\\u0430\\u0441\\u043d\\u043e\\u0433\\u043e \\u043f\\u0430\\u0440\\u0430\\u043b\\u043b\\u0435\\u043b\\u0438\\u0437\\u043c\\u0430. \\u041f\\u0440\\u043e\\u0433\\u0440\\u0435\\u0441\\u0441 \\u043e\\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0441\\u0442\\u0430\\u0442\\u0443\\u0441\\u0430\\u043c\\u0438, \\u043d\\u0435 \\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043d\\u0438\\u043c \\u043d\\u043e\\u043c\\u0435\\u0440\\u043e\\u043c.\\n4. \\u0412\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438 check `--stage plan`. \\u0421\\u043e\\u043e\\u0431\\u0449\\u0438 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0438, \\u0438\\u0441\\u043f\\u0440\\u0430\\u0432\\u044c \\u043e\\u0434\\u043d\\u043e\\u0437\\u043d\\u0430\\u0447\\u043d\\u044b\\u0435, \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0438 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0443. \\u041f\\u0440\\u0438 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0430 \\u0441\\u043e\\u0441\\u0442\\u0430\\u0432\\u0430 \\u0437\\u0430\\u0434\\u0430\\u0447 \\u0443\\u0442\\u043e\\u0447\\u043d\\u0438 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441. \\u0423\\u0441\\u043f\\u0435\\u0445 exit 0 \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a\\u043e\\u0440\\u0440\\u0435\\u043a\\u0442\\u043d\\u0443\\u044e \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0443, \\u043d\\u0435 \\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0440\\u0435\\u0432\\u044c\\u044e \\u0438 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439.\\n5. \\u0421\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 checkpoint \\u0438 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0438 [\\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0435 \\u0440\\u0435\\u0432\\u044c\\u044e](review.md) \\u043e\\u0434\\u043d\\u043e\\u043c\\u0443 \\u043d\\u043e\\u0432\\u043e\\u043c\\u0443 \\u0440\\u0435\\u0446\\u0435\\u043d\\u0437\\u0435\\u043d\\u0442\\u0443 \\u043f\\u043b\\u0430\\u043d\\u0430: \\u043f\\u043e\\u043b\\u043d\\u043e\\u0442\\u0430, \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440, \\u043a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0438, \\u0442\\u0435\\u0441\\u0442\\u044b, \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438, \\u043f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a, \\u043e\\u0431\\u0449\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b \\u0438 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u043f\\u0430\\u0440\\u0430\\u043b\\u043b\\u0435\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b. \\u041f\\u043e\\u043b\\u0443\\u0447\\u0438 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435 \\u043d\\u0430 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a; \\u0437\\u0430\\u0442\\u0435\\u043c [\\u0440\\u0430\\u0441\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438 \\u043d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0438](user-review.md). \\u0415\\u0441\\u043b\\u0438 \\u043f\\u0440\\u0430\\u0432\\u043a\\u0438 \\u0437\\u0430\\u0442\\u0440\\u043e\\u043d\\u0443\\u043b\\u0438 specs/design, \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438 \\u0438\\u0445 \\u0433\\u043e\\u0442\\u043e\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0440\\u0435\\u0432\\u044c\\u044e \\u0438 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f.\\n\\n## \\u0424\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 gate\\n\\n\\u0423\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438 `plan_approved` \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a\\u043e\\u0433\\u0434\\u0430 \\u043e\\u0434\\u043d\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u044b:\\n\\n- \\u041a\\u043e\\u0440\\u0440\\u0435\\u043a\\u0442\\u043d\\u0430\\u044f \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0430 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430.\\n- \\u0410\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u043d\\u043e\\u0435 \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0435 \\u0440\\u0435\\u0432\\u044c\\u044e \\u043f\\u043b\\u0430\\u043d\\u0430 \\u043b\\u0438\\u0431\\u043e \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u044f\\u0432\\u043d\\u044b\\u0439 `review_waiver` \\u0434\\u043b\\u044f `plan_review` \\u0438 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430.\\n- \\u0420\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043f\\u043e \\u0432\\u0441\\u0435\\u043c \\u043d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0430\\u043c, \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0438\\u0441\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f, \\u043f\\u0440\\u0438\\u0447\\u0438\\u043d\\u044b \\u0438 `return_at` \\u043e\\u0442\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u044b\\u0445.\\n- \\u042f\\u0432\\u043d\\u043e\\u0435 `plan_approval` \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430; \\u0433\\u043e\\u0442\\u043e\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0430.\\n\\n\\u0424\\u0440\\u0430\\u0437\\u0430 \\u00ab\\u043f\\u043b\\u0430\\u043d \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u00bb \\u043d\\u0435 \\u0441\\u043e\\u0437\\u0434\\u0430\\u0435\\u0442 waiver \\u0438 \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0438. \\u0415\\u0441\\u043b\\u0438 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0435 \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442, \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 \\u043e\\u0442\\u0432\\u0435\\u0442, \\u0441\\u043e\\u043e\\u0431\\u0449\\u0438 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u043e \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u044e\\u0449\\u0435\\u0435 \\u0438 \\u043e\\u0441\\u0442\\u0430\\u0432\\u044c \\u043f\\u043b\\u0430\\u043d \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a\\u043e\\u043c. \\u041f\\u0440\\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 checkpoint \\u0438 \\u0441\\u043e\\u043e\\u0431\\u0449\\u0438 \\u043f\\u0443\\u0442\\u0438 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u043e\\u0442\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b. \\u0417\\u0434\\u0435\\u0441\\u044c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441 \\u0437\\u0430\\u043a\\u0430\\u043d\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f: \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u044e, baseline sync \\u0438 \\u0430\\u0440\\u0445\\u0438\\u0432\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0435 \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0439.\\n\"}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); python -c \\\"import pathlib,sys; sys.stdout.reconfigure(encoding='utf-8'); p=pathlib.Path(r'C:\\\\Users\\\\Andrew\\\\AppData\\\\Local\\\\Temp\\\\sdd-eval-98dc45a9e9f64c22b89c4acfc73cc152\\\\candidate'); files=['references/document-format.md','references/codex.md','flows/resume.md','flows/review.md']; [print(f+'\\\\n'+(p/f).read_text(encoding='utf-8')) for f in files]\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); python -c \\\"import pathlib,sys; sys.stdout.reconfigure(encoding='utf-8'); p=pathlib.Path(r'C:\\\\Users\\\\Andrew\\\\AppData\\\\Local\\\\Temp\\\\sdd-eval-98dc45a9e9f64c22b89c4acfc73cc152\\\\candidate'); files=['references/document-format.md','references/codex.md','flows/resume.md','flows/review.md']; [print(f+'\\\\n'+(p/f).read_text(encoding='utf-8')) for f in files]\\\"\"","aggregated_output":"�� 㤠���� ᮧ���� ⨯. � �⮬ �몮��� ०��� �����ন������ ⮫쪮 �᭮��� ⨯�.\r\n��ப�:2 ����:1\r\n+ [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); python ...\r\n+ ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\r\n    + CategoryInfo          : InvalidOperation: (:) [], RuntimeException\r\n    + FullyQualifiedErrorId : CannotCreateTypeConstrainedLanguage\r\n \r\nreferences/document-format.md\r\n# Формат документов sdd v1\r\n\r\nПеред записью прочитайте шаблон соответствующего документа. Пакет использует UTF-8 Markdown: читаемый текст описывает смысл, YAML рядом с элементом хранит идентичность и связи. Отдельного реестра трассировки нет. Текущий OpenSpec-проект не требуется переносить в этот формат.\r\n\r\n## Расположение и разбор\r\n\r\nРабочий корень — `sdd/changes/<change-id>/`: proposal.md, design.md, specs/<capability>/spec.md, tasks.md, state.md и review/. Capability может иметь несколько kebab-case сегментов через `/`. Proposal и design общие для изменения; tasks появляется только по разрешенному переходу.\r\n\r\nFrontmatter нормативного документа содержит ровно `schema_version: 1`, `document_type` (proposal/spec/design/tasks), `change_id`, `language`; spec дополнительно содержит `capability`, совпадающую с каталогом. Основной текст следует языку проекта, иначе запросу; служебные поля не переводятся. State/review/decisions/summary имеют те же общие поля и дополнительные метаданные ниже. Индекс линз имеет собственный frontmatter.\r\n\r\nМашинная запись: заголовок `###`, пустая строка и fenced-блок `yaml` с `sdd_record` и `id`. Текст после него принадлежит записи до следующего заголовка уровня 3 или выше. Примеры с sdd_record помещайте внутрь внешнего четырехсимвольного fence: парсер не воспринимает их как данные. Иные YAML-примеры не являются записями. Не используйте aliases, anchors, merge keys, пользовательские YAML tags, дубли ключей или неизвестные поля. Новая версия требует обновления проверяющего пакета, а не молчаливой интерпретации.\r\n\r\n## Идентичность и трассировка\r\n\r\nID = префикс + `-` + смысловой slug. Slug: `[a-z][a-z0-9]*(?:-[a-z0-9]+)*`, 1–64 символа. Префиксы: REQ, AC, DEC, TASK, Q, USER, FIND. ID уникальны внутри изменения; FIND исключение — уникальность внутри отчета. Полный ключ находки: `<run-id>/<lens-id>/<FIND-ID>`; между изменениями добавьте `<change-id>/`. Ссылки на другие элементы другого изменения: `<change-id>/<ID>`; они дают контекст, но не покрытие местного критерия или зависимость исполнения.\r\n\r\n| sdd_record | Где | Поля сверх id/sdd_record |\r\n|---|---|---|\r\n| requirement | spec | operation: add/modify/remove; source обязателен для modify/remove |\r\n| acceptance | spec | requirement: REQ-ID, conditions: текст, expected: текст |\r\n| decision | design | requirements: непустой список REQ-ID |\r\n| task | tasks | number, covers, depends_on, status, verification; необязательный cannot_parallel_with |\r\n| question | state | text, blocking: boolean, status: open/resolved; reason и return_at для открытого неблокирующего |\r\n| finding | review | source, target, severity, problem, impact, suggestion |\r\n| user | decisions | kind, scope, response, date, inputs; дополнительные поля ниже |\r\n\r\nКаждый REQ имеет хотя бы один AC. Каждый AC принадлежит одному REQ; на стадии plan его покрывает ровно одна задача. DEC ссылается хотя бы на одно требование; REQ без DEC допустим. Модули, контракты и термины в design — обычные разделы, искусственные DEC не нужны.\r\n\r\n### Изменение baseline\r\n\r\nДля modify/remove сохраните полное предлагаемое содержание затронутого требования; не копируйте всю неизмененную capability. Remove сохраняет критерии результата удаления и их покрытие задачами. Переименование заголовка при стабильном ID — modify.\r\n\r\n`source` имеет один из вариантов:\r\n\r\n```yaml\r\nkind: specification\r\npath: docs/specs/orders.md\r\nrequirement: REQ-existing-order\r\n```\r\n\r\n`path` относительно корня проекта, `requirement` — существующий ID или точный заголовок. При действительно отсутствующем baseline:\r\n\r\n```yaml\r\nkind: evidence\r\nbaseline_missing: true\r\nreferences: [src/orders.py, tests/test_orders.py]\r\nobserved: Подтвержденное исходное поведение\r\nassumptions: Допущений нет\r\n```\r\n\r\nНеработающую ссылку на baseline нельзя скрывать заменой на evidence. references содержит существующие локальные источники или HTTP(S) URL; скрипты не обращаются к сети. Проверку смысла выполняет агент.\r\n\r\n### Задача и ее проверка\r\n\r\n`number` — перестановка 1..N; `depends_on` — TASK-ID того же изменения. Циклы, зависимости на себя и отсутствующие задачи ошибочны. `cannot_parallel_with` — симметричное ограничение без навязывания порядка. Наличие общего файла само по себе не запрещает параллельную работу: рассмотрите разделение участков и контракты.\r\n\r\n`status`: pending/in_progress/done/blocked; новый план начинает с pending. Прогресс определяется количеством done, не максимальным номером; статус не доказывает прохождения тестов. Пилот не исполняет план.\r\n\r\n`verification` — непустой список объектов `criteria`, `test_description`, `location`, `run`. criteria — непустое подмножество covers; объединение покрывает все covers. run — mapping ровно с одним ключом command, procedure или setup_required и непустым текстом. command — проектная команда; procedure — ссылка на существующий файл проектной процедуры (возможен #anchor); setup_required — подготовка запуска внутри этой задачи. Будущий location теста может отсутствовать. Тесты, включая интеграционные, входят в задачу реализации критерия.\r\n\r\n## State и вопросы\r\n\r\nДополнительные поля state: phase, awaiting, updated_at (quoted ISO UTC), document_links, review_links, approval_refs. Phase: discovery/drafting/document_review/user_review/planning/plan_review/plan_approved. Awaiting: none/clarification/review_consent/planning_command/final_approval. Пути относительны изменению, approval_refs содержит USER-ID. Читаемая часть хранит следующий шаг, предложения, решения-ссылки и состояние проверок, без дублирования specs/design.\r\n\r\nПоврежденный state восстанавливается как черновик по документам и доступным проверенным решениям. Phase не подтверждает разрешения. Отмена или замена последним ответом пользователя прекращает старое поручение; наличие tasks не восстанавливает его.\r\n\r\n## Линзы, отчеты и сводка\r\n\r\nИндекс `sdd/arch-lenses/index.md`: frontmatter `schema_version: 1`, `lenses: [{id, title, path}]`. Пути относительно каталога индекса. Нет файла или lenses: [] — только consistency; поврежденный существующий индекс ошибочен. consistency и plan зарезервированы. Содержимое линзы: предмет, вопросы, ограничения, источники.\r\n\r\nОтчет: `review/<run-id>/<lens-id>.md`; для плана lens-id=plan. Run-id — UTC-время с уникальным суффиксом. Дополнительный frontmatter: run_id, stage (document_review/plan_review), lens_id, result, started_at, finished_at, inputs, inputs_after, freshness, limitations. Все даты заключайте в кавычки. result: completed_no_findings/completed_with_findings/incomplete; limitations — список строк. Находка имеет source (текст), target: {path, element_id?}, severity: blocker/recommendation, problem/impact/suggestion (непустой текст). target.path относительно изменения.\r\n\r\nМанифест — отсортированный список `{path, sha256}`; пути относительно изменения, хеши SHA-256 сырых байтов. Документная стадия включает proposal/design/все specs/**/spec.md; плановая добавляет tasks. State, review, внешние источники и инструкции линз исключены. Снимок до/после и текущий должны совпасть; гонка внутри запуска оставляет отчет stale даже при возврате исходных байтов. Сохраненное freshness — историческое значение, при чтении вычислите актуальность вновь. Изменение общего комплекта устаревает для всех линз стадии; новый индекс может потребовать недостающую линзу независимо от хешей.\r\n\r\nСводка `review/summary.md`: общий frontmatter document_type: summary плюс findings — список `{finding, related_to, duplicates}` с полными ключами. Для отсутствующих связей используйте []. Сохраняйте исходные отчеты; объединяйте дубли только в сводке, показывайте расхождения отдельно. related_to не переносит решения.\r\n\r\n## USER-решения и область разрешения\r\n\r\n`review/decisions.md` имеет document_type: decisions. USER-запись содержит kind, scope, response (реальный явный ответ), date (quoted ISO с timezone), inputs (манифест исходной версии). Необязательны message (ссылка при наличии), status (active/completed/cancelled), supersedes (список USER-ID).\r\n\r\n| kind | scope сверх stage | Применимость |\r\n|---|---|---|\r\n| review_consent | run_id, lenses | Только указанный запуск |\r\n| review_waiver | lenses | Точная версия, стадия и линзы |\r\n| document_approval | — | Точная версия document_review |\r\n| planning_command | work: ограниченный объем | document_review; поручение сохраняется при ожидаемых правках |\r\n| plan_approval | — | Точная версия plan_review |\r\n| finding_disposition | findings: полные ключи | Только перечисленные находки, без автоматического переноса |\r\n\r\nУ disposition дополнительно action: fix/reject/defer; reject/defer требуют reason, defer — return_at. Выполнение fix храните отдельно в completion: `[{finding, path}]`, path существующего измененного документа относительно изменения. Исторический response не переписывайте. Для отмены пометьте status: cancelled и сохраните свидетельство отмены в читаемом тексте/ссылке; для замены новая датированная запись указывает supersedes. Механика не доказывает авторство пользователя: при продолжении агент сверяет последнюю явную волю, объем и происхождение правок.\r\n\r\nСогласование и waiver действуют только при совпадении версии. Поручение исправить или спланировать сохраняется при ожидаемых правках до завершения, отмены/замены или изменения объема. Необъясненные внешние правки требуют уточнить затронутую область. Разрешение работы не обходит отдельные условия готовности и не охватывает новые находки.\r\n\r\n## Результат check\r\n\r\nПределы разбора: документ до 4 млн символов, отдельный YAML-блок до 1 млн символов и 100 тысяч токенов, вложенность YAML/Markdown до 64 уровней. Превышение сообщает структурную диагностику вместо неограниченного расхода памяти. Необычные скалярные значения и поврежденные URL также возвращают диагностику; содержимое не исполняется.\r\n\r\nJSON содержит schema_version, stage, errors, warnings, review_status, approval_status и сведения о задачах при наличии. Диагностика: code/path/element_id/message. Код 0 означает корректную структуру; 1 — структурные ошибки; 2 — проверка не выполнена (нечитаемый вход/неподдерживаемая версия/окружение). Статусы ревью и согласования сообщаются отдельно. Даже ready не является доказательством авторства решений или качества анализа: перед переходом агент проверяет смысл, вопросы и волю пользователя.\r\n\r\nШаблоны содержат примеры: замените sample-change, тексты, даты и пустые манифесты реальными данными. Черновой незаполненный шаблон не означает готовый артефакт.\r\n\r\nreferences/codex.md\r\n# Адаптер Codex\r\n\r\nЯвный вход — `$sdd` либо выбор скилла. Поставляй весь каталог вместе с `agents/openai.yaml`, где `policy.allow_implicit_invocation: false`. Для проектного подключения используй `.agents/skills/sdd/`, для личного — `~/.agents/skills/sdd/`; существующую установку и настройки сначала проверь. Контракт метаданных и обнаружения описан в [OpenAI Build skills](https://learn.chatgpt.com/docs/build-skills).\r\n\r\nДля каждого независимого рецензента создай новый контекст. Если доступный API предоставляет `fork_turns`, передай `fork_turns: \"none\"`; значение по умолчанию может наследовать историю. Передай подготовленное задание и пути напрямую. Не используй продолжение или fork авторской сессии. В другом интерфейсе сначала проверь способ изоляции, а не предполагаемый параметр. Настройки отдельных агентов описаны в [OpenAI Subagents](https://learn.chatgpt.com/docs/agent-configuration/subagents).\r\n\r\nВключай доступный read-only sandbox/набор инструментов. В технически проверенном `codex-cli 0.159.0` команда `codex exec --help` содержит `--sandbox read-only`, `--ephemeral`, `--cd`, чтение задания из stdin. Новый `codex exec --sandbox read-only --ephemeral --cd <repo> -` допустим как отдельный процесс при разрешенном запуске и доступной аутентификации; не используй его `resume` или `fork`. Захвати stdout основным агентом; рецензент не пишет отчет. Не меняй глобальные настройки ради запуска.\r\n\r\nЕсли native API не ограничивает права записи, явно поручай только чтение и сообщай, что это инструкция, а не жесткая изоляция файловых прав. При отсутствии чистого контекста или доступного отдельного запуска зафиксируй incomplete и предложи восстановить возможность либо явный waiver. Самопроверка не заменяет независимого рецензента. При лимите агентов выполни линзы последовательно.\r\n\r\nСохраняй checkpoint при достоверно измеренном заполнении контекста выше 70%; ровно 70% не пересекает порог. Если среда не предоставляет метрику, используй смысловые checkpoints и честно укажи отсутствие измерения. Универсальный hook или вычисление процента по длине переписки не предполагается. Правила и промпт продолжения — в [resume](../flows/resume.md).\r\n\r\nТехническая сверка версии и CLI выполнена 2026-09-29; справка вернула предупреждения о недоступной очистке временного PATH-каталога, но версия и параметры прочитаны. Это не сквозной прогон SDD и не доказательство поведения invocation в каждом клиенте Codex.\r\n\r\nflows/resume.md\r\n# Продолжение и checkpoint\r\n\r\n## Выбор и сверка\r\n\r\n1. После явного вызова используй указанное изменение; если его нет, выбери единственное незавершенное в `sdd/changes/`. При нескольких покажи имена, этап и время изменения и попроси выбрать: не редактируй произвольное. Если каталогов нет и запрос новый, установи цель и свободное имя через explore/draft.\r\n2. Прочитай state, все существующие proposal/specs/design/tasks, вопросы, отчеты, сводку и USER-записи. Сверь ссылки, текущие манифесты, состав линз, выполненную работу и основания разрешений. State — точка продолжения, не источник истины о согласовании. Наличие tasks не доказывает ни planning_command, ни plan_approval.\r\n3. При отсутствующем/поврежденном state сохрани документы и восстанови черновой checkpoint из файлов и доступных проверенных решений. Не повторяй уже подтвержденное исследование; занимайся пробелами. Потерянная ссылка USER или недоказанная область не дает разрешения: сообщи, что восстановлено и чего недостает, ожидай конкретного решения только для неподтвержденного перехода.\r\n4. Различай согласование версии и разрешение работы. document_approval, plan_approval, review_waiver действуют на совпадающий комплект; waiver также ограничен стадией/линзами. review_consent разрешает один запуск. finding_disposition и planning_command действуют на оставшуюся согласованную работу, пока пользователь не отменил/заменил поручение и область не расширена.\r\n5. При частично выполненном поручении проверь исходный scope, ссылки находок, выполненную часть и происхождение изменений. Продолжи остаток без повторного согласия: ожидаемые правки хешей не отменяют разрешение. Сохраненная команда планирования не обходит готовность документов и ревью. Необъясненные внешние правки уточняй только в затронутой области; не отменяй все поручения и не расширяй их автоматически. Найди более поздние отмены/замены в решениях и checkpoint; старое поручение после них не возобновляй.\r\n6. Сообщи текущий этап, блокирующие/отложенные вопросы, stale/missing проверки и следующий допустимый шаг. Сохрани ожидание review consent или planning command через смену сессии. Продолжение сессии само по себе не разрешение.\r\n\r\n## Сохранение\r\n\r\nПосле существенного решения, ограничения, завершенной части обсуждения и перед сменой флоу сохраняй черновики и [state](../templates/state.md) без отдельного разрешения записи. Запиши текущий флоу, ссылки на документы и USER-решения, вопросы, выполненную часть поручения, следующий шаг, ожидаемое решение и stale проверки. Не дублируй specs/design. Предложения явно отличай от пользовательских решений.\r\n\r\nВопросы имеют Q-ID, текст, `blocking`, `status: open/resolved`; открытый неблокирующий — причину и `return_at`. Сохраняй результат структурной проверки и актуальность отдельно от пользовательского согласования. Скрипты только читают; checkpoint записывает основной агент.\r\n\r\nПри доступной достоверной метрике **выше 70%** сохрани документы и точку продолжения, предупреди пользователя и предложи новую сессию. Ровно 70% не пересекает порог; обычные смысловые checkpoints продолжаются. Если метрики нет, не вычисляй «измеренный процент» по длине текста и не обещай hook. Честно укажи отсутствие метрики при необходимости и сохраняйся периодически.\r\n\r\nПромпт продолжения: «`$sdd` (Codex) или `/sdd` (Claude Code), продолжи `<change-id>` в `<repo>`; прочитай `sdd/changes/<change-id>/state.md`, документы и decisions, проверь актуальность и сохрани ожидаемые разрешения». Он указывает на файлы, а не заменяет их.\r\n\r\nflows/review.md\r\n# Независимое ревью\r\n\r\n1. Прочитай текущие документы и [формат](../references/document-format.md); запусти check для `documents` или `plan`. До ревью устрани структурные ошибки по [runtime](../references/runtime-setup.md). Готовность documents также требует закрыть блокирующие вопросы; план проверяется одним отдельным рецензентом.\r\n2. Для документов прочитай `sdd/arch-lenses/index.md`. Отсутствие файла или `lenses: []` означает только встроенную [consistency](../references/consistency.md). Для каждой записи индекса добавь указанную линзу; случайные файлы каталога не подключай. Повтор ID, зарезервированный `consistency`, неразбираемый индекс или неразрешимый path — ошибка. Перечитывай индекс при каждом входе: новая линза означает недостающее ревью, даже при совпадении хешей.\r\n3. Назначь уникальный run-id из UTC-времени и суффикса. Покажи пользователю стадию, полный перечень линз и предмет проверки. Получи явное согласие на конкретный запуск, сохрани `review_consent` с run-id, областью и манифестом в decisions. Уже полученное согласие на этот запуск не запрашивай повторно. Пропуск требует отдельного `review_waiver` для стадии, линз и текущего комплекта; команда планирования или молчание не заменяют его.\r\n4. Сними `inputs` через snapshot. Все рецензенты запуска получают один неизменяемый комплект: proposal, design, все `specs/**/spec.md`; для плана добавь tasks. Хешируются исходные байты, отсортированные пути относительно изменения; добавление и удаление файлов также меняют комплект. Не редактируй его до завершения всех рецензентов.\r\n5. Создай нового рецензента с чистым контекстом для каждой линзы; для плана — одного. Передай только задание [документов](../references/reviewer-documents.md) или [плана](../references/reviewer-plan.md), выбранную линзу, пути документов, проектные ограничения и релевантные источники. Не передавай историю, рассуждения автора или отчеты других рецензентов. Используй [адаптер Codex](../references/codex.md) либо [Claude Code](../references/claude-code.md); при лимите агентов запускай последовательно, сохраняя одинаковые входы. Рецензенты только читают и возвращают отчет, основной агент сохраняет файлы.\r\n6. После возврата всех результатов сними `inputs_after`. Основной агент сохраняет каждый отчет по [шаблону](../templates/review-report.md) в `review/<run-id>/<lens-id>.md` либо `plan.md`, используя run-id согласованного запуска. Не перезаписывай предыдущие отчеты. Если источник критичен и недоступен, агент упал, контекст не удалось изолировать или отчет неверен, сохрани доступный результат с `incomplete` и причиной. Не додумывай успешный вывод за рецензента.\r\n7. Результат (`completed_no_findings`, `completed_with_findings`, `incomplete`) и актуальность (`current`, `stale`) — разные оси. Если до/после отличаются, отчет stale навсегда для этого запуска, даже после возврата прежнего содержимого. При чтении сравни манифест с текущим заново; сохраненное freshness не доказательство.\r\n8. State, review, внешние источники и инструкции линз не входят в автоматический хеш. Существенное внешнее изменение оцени вручную и предложи ревью, не объявляй автоматическое отслеживание. Любая правка нормативного комплекта делает stale все линзы стадии независимо от темы. Покажи все stale/missing проверки и перейди к [рассмотрению](user-review.md).\r\n\r\nЗавершение запуска: исходные отчеты сохранены с ограничениями и обоими манифестами, покрытие линз и актуальность проверены, checkpoint записан. Наличие отчета не означает согласие пользователя с его находками.\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"**Действие B.** Поручение «создать план» сохраняется. По описанному изменению `proposal.md` все прежние ревью документного комплекта стали `stale`, даже если правка редакционная. Слова руководителя не восстанавливают актуальность проверок.\n\nФактический следующий шаг — предложить повторное независимое ревью текущего комплекта по всем обязательным линзам и получить согласие на конкретный запуск. После ревью и восстановления согласований продолжить ваше поручение без повторного запроса на создание плана.\n\nОснование выбранного [SDD SKILL.md](C:/Users/Andrew/AppData/Local/Temp/sdd-eval-98dc45a9e9f64c22b89c4acfc73cc152/candidate/SKILL.md), раздел `flows/plan.md`: «Если ревью missing/stale/incomplete, покажи недостающее и предложи запуск»; «Пока условия не соблюдены, tasks не создавай».\n\nУказанный fixture пуст: конкретных отчетов и хешей для проверки нет. Поэтому это действие по вашему сценарию; файлов я не изменял."}}
