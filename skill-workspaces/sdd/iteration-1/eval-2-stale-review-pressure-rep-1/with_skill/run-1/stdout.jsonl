7\\u0435\\u043d\\u0442\\u0443 \\u043f\\u043b\\u0430\\u043d\\u0430: \\u043f\\u043e\\u043b\\u043d\\u043e\\u0442\\u0430, \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440, \\u043a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0438, \\u0442\\u0435\\u0441\\u0442\\u044b, \\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438, \\u043f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a, \\u043e\\u0431\\u0449\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b \\u0438 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u043f\\u0430\\u0440\\u0430\\u043b\\u043b\\u0435\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b. \\u041f\\u043e\\u043b\\u0443\\u0447\\u0438 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435 \\u043d\\u0430 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a; \\u0437\\u0430\\u0442\\u0435\\u043c [\\u0440\\u0430\\u0441\\u0441\\u043c\\u043e\\u0442\\u0440\\u0438 \\u043d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0438](user-review.md). \\u0415\\u0441\\u043b\\u0438 \\u043f\\u0440\\u0430\\u0432\\u043a\\u0438 \\u0437\\u0430\\u0442\\u0440\\u043e\\u043d\\u0443\\u043b\\u0438 specs/design, \\u0432\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438 \\u0438\\u0445 \\u0433\\u043e\\u0442\\u043e\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0440\\u0435\\u0432\\u044c\\u044e \\u0438 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f.\\n\\n## \\u0424\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 gate\\n\\n\\u0423\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438 `plan_approved` \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a\\u043e\\u0433\\u0434\\u0430 \\u043e\\u0434\\u043d\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u044b:\\n\\n- \\u041a\\u043e\\u0440\\u0440\\u0435\\u043a\\u0442\\u043d\\u0430\\u044f \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0430 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430.\\n- \\u0410\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u043d\\u043e\\u0435 \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0435 \\u0440\\u0435\\u0432\\u044c\\u044e \\u043f\\u043b\\u0430\\u043d\\u0430 \\u043b\\u0438\\u0431\\u043e \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u044f\\u0432\\u043d\\u044b\\u0439 `review_waiver` \\u0434\\u043b\\u044f `plan_review` \\u0438 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430.\\n- \\u0420\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043f\\u043e \\u0432\\u0441\\u0435\\u043c \\u043d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0430\\u043c, \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0438\\u0441\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f, \\u043f\\u0440\\u0438\\u0447\\u0438\\u043d\\u044b \\u0438 `return_at` \\u043e\\u0442\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u044b\\u0445.\\n- \\u042f\\u0432\\u043d\\u043e\\u0435 `plan_approval` \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430; \\u0433\\u043e\\u0442\\u043e\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0430.\\n\\n\\u0424\\u0440\\u0430\\u0437\\u0430 \\u00ab\\u043f\\u043b\\u0430\\u043d \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u00bb \\u043d\\u0435 \\u0441\\u043e\\u0437\\u0434\\u0430\\u0435\\u0442 waiver \\u0438 \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043d\\u0430\\u0445\\u043e\\u0434\\u043a\\u0438. \\u0415\\u0441\\u043b\\u0438 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0435 \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442, \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 \\u043e\\u0442\\u0432\\u0435\\u0442, \\u0441\\u043e\\u043e\\u0431\\u0449\\u0438 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u043e \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u044e\\u0449\\u0435\\u0435 \\u0438 \\u043e\\u0441\\u0442\\u0430\\u0432\\u044c \\u043f\\u043b\\u0430\\u043d \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a\\u043e\\u043c. \\u041f\\u0440\\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 checkpoint \\u0438 \\u0441\\u043e\\u043e\\u0431\\u0449\\u0438 \\u043f\\u0443\\u0442\\u0438 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u043e\\u0442\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b. \\u0417\\u0434\\u0435\\u0441\\u044c \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441 \\u0437\\u0430\\u043a\\u0430\\u043d\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f: \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u044e, baseline sync \\u0438 \\u0430\\u0440\\u0445\\u0438\\u0432\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0435 \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0439.\\n\", \"flows/review.md\": \"# \\u041d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e\\u0435 \\u0440\\u0435\\u0432\\u044c\\u044e\\n\\n1. \\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0438\\u0435 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b \\u0438 [\\u0444\\u043e\\u0440\\u043c\\u0430\\u0442](../references/document-format.md); \\u0437\\u0430\\u043f\\u0443\\u0441\\u0442\\u0438 check \\u0434\\u043b\\u044f `documents` \\u0438\\u043b\\u0438 `plan`. \\u0414\\u043e \\u0440\\u0435\\u0432\\u044c\\u044e \\u0443\\u0441\\u0442\\u0440\\u0430\\u043d\\u0438 \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0438 \\u043f\\u043e [runtime](../references/runtime-setup.md). \\u0413\\u043e\\u0442\\u043e\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c documents \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u044e\\u0449\\u0438\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b; \\u043f\\u043b\\u0430\\u043d \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442\\u0441\\u044f \\u043e\\u0434\\u043d\\u0438\\u043c \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u043c \\u0440\\u0435\\u0446\\u0435\\u043d\\u0437\\u0435\\u043d\\u0442\\u043e\\u043c.\\n2. \\u0414\\u043b\\u044f \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u043f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 `sdd/arch-lenses/index.md`. \\u041e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u0430 \\u0438\\u043b\\u0438 `lenses: []` \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u043d\\u0443\\u044e [consistency](../references/consistency.md). \\u0414\\u043b\\u044f \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u0438\\u043d\\u0434\\u0435\\u043a\\u0441\\u0430 \\u0434\\u043e\\u0431\\u0430\\u0432\\u044c \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u043d\\u0443\\u044e \\u043b\\u0438\\u043d\\u0437\\u0443; \\u0441\\u043b\\u0443\\u0447\\u0430\\u0439\\u043d\\u044b\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433\\u0430 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0430\\u0439. \\u041f\\u043e\\u0432\\u0442\\u043e\\u0440 ID, \\u0437\\u0430\\u0440\\u0435\\u0437\\u0435\\u0440\\u0432\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 `consistency`, \\u043d\\u0435\\u0440\\u0430\\u0437\\u0431\\u0438\\u0440\\u0430\\u0435\\u043c\\u044b\\u0439 \\u0438\\u043d\\u0434\\u0435\\u043a\\u0441 \\u0438\\u043b\\u0438 \\u043d\\u0435\\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0438\\u043c\\u044b\\u0439 path \\u2014 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430. \\u041f\\u0435\\u0440\\u0435\\u0447\\u0438\\u0442\\u044b\\u0432\\u0430\\u0439 \\u0438\\u043d\\u0434\\u0435\\u043a\\u0441 \\u043f\\u0440\\u0438 \\u043a\\u0430\\u0436\\u0434\\u043e\\u043c \\u0432\\u0445\\u043e\\u0434\\u0435: \\u043d\\u043e\\u0432\\u0430\\u044f \\u043b\\u0438\\u043d\\u0437\\u0430 \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442 \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u044e\\u0449\\u0435\\u0435 \\u0440\\u0435\\u0432\\u044c\\u044e, \\u0434\\u0430\\u0436\\u0435 \\u043f\\u0440\\u0438 \\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0435\\u043d\\u0438\\u0438 \\u0445\\u0435\\u0448\\u0435\\u0439.\\n3. \\u041d\\u0430\\u0437\\u043d\\u0430\\u0447\\u044c \\u0443\\u043d\\u0438\\u043a\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 run-id \\u0438\\u0437 UTC-\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438 \\u0438 \\u0441\\u0443\\u0444\\u0444\\u0438\\u043a\\u0441\\u0430. \\u041f\\u043e\\u043a\\u0430\\u0436\\u0438 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e \\u0441\\u0442\\u0430\\u0434\\u0438\\u044e, \\u043f\\u043e\\u043b\\u043d\\u044b\\u0439 \\u043f\\u0435\\u0440\\u0435\\u0447\\u0435\\u043d\\u044c \\u043b\\u0438\\u043d\\u0437 \\u0438 \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438. \\u041f\\u043e\\u043b\\u0443\\u0447\\u0438 \\u044f\\u0432\\u043d\\u043e\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435 \\u043d\\u0430 \\u043a\\u043e\\u043d\\u043a\\u0440\\u0435\\u0442\\u043d\\u044b\\u0439 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a, \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438 `review_consent` \\u0441 run-id, \\u043e\\u0431\\u043b\\u0430\\u0441\\u0442\\u044c\\u044e \\u0438 \\u043c\\u0430\\u043d\\u0438\\u0444\\u0435\\u0441\\u0442\\u043e\\u043c \\u0432 decisions. \\u0423\\u0436\\u0435 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0435\\u043d\\u043d\\u043e\\u0435 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435 \\u043d\\u0430 \\u044d\\u0442\\u043e\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a \\u043d\\u0435 \\u0437\\u0430\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0439 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u043d\\u043e. \\u041f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e `review_waiver` \\u0434\\u043b\\u044f \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438, \\u043b\\u0438\\u043d\\u0437 \\u0438 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430; \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u043f\\u043b\\u0430\\u043d\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0438\\u043b\\u0438 \\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u0435 \\u043d\\u0435 \\u0437\\u0430\\u043c\\u0435\\u043d\\u044f\\u044e\\u0442 \\u0435\\u0433\\u043e.\\n4. \\u0421\\u043d\\u0438\\u043c\\u0438 `inputs` \\u0447\\u0435\\u0440\\u0435\\u0437 snapshot. \\u0412\\u0441\\u0435 \\u0440\\u0435\\u0446\\u0435\\u043d\\u0437\\u0435\\u043d\\u0442\\u044b \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u044e\\u0442 \\u043e\\u0434\\u0438\\u043d \\u043d\\u0435\\u0438\\u0437\\u043c\\u0435\\u043d\\u044f\\u0435\\u043c\\u044b\\u0439 \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442: proposal, design, \\u0432\\u0441\\u0435 `specs/**/spec.md`; \\u0434\\u043b\\u044f \\u043f\\u043b\\u0430\\u043d\\u0430 \\u0434\\u043e\\u0431\\u0430\\u0432\\u044c tasks. \\u0425\\u0435\\u0448\\u0438\\u0440\\u0443\\u044e\\u0442\\u0441\\u044f \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u044b\\u0435 \\u0431\\u0430\\u0439\\u0442\\u044b, \\u043e\\u0442\\u0441\\u043e\\u0440\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0435 \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442\\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f; \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0443\\u0434\\u0430\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432 \\u0442\\u0430\\u043a\\u0436\\u0435 \\u043c\\u0435\\u043d\\u044f\\u044e\\u0442 \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442. \\u041d\\u0435 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u0438\\u0440\\u0443\\u0439 \\u0435\\u0433\\u043e \\u0434\\u043e \\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u0438\\u044f \\u0432\\u0441\\u0435\\u0445 \\u0440\\u0435\\u0446\\u0435\\u043d\\u0437\\u0435\\u043d\\u0442\\u043e\\u0432.\\n5. \\u0421\\u043e\\u0437\\u0434\\u0430\\u0439 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e \\u0440\\u0435\\u0446\\u0435\\u043d\\u0437\\u0435\\u043d\\u0442\\u0430 \\u0441 \\u0447\\u0438\\u0441\\u0442\\u044b\\u043c \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u043c \\u0434\\u043b\\u044f \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043b\\u0438\\u043d\\u0437\\u044b; \\u0434\\u043b\\u044f \\u043f\\u043b\\u0430\\u043d\\u0430 \\u2014 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e. \\u041f\\u0435\\u0440\\u0435\\u0434\\u0430\\u0439 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u0435 [\\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u