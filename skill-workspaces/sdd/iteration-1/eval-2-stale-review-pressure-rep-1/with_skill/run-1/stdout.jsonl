442\\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f, \\u0445\\u0435\\u0448\\u0438 SHA-256 \\u0441\\u044b\\u0440\\u044b\\u0445 \\u0431\\u0430\\u0439\\u0442\\u043e\\u0432. \\u0414\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043d\\u0430\\u044f \\u0441\\u0442\\u0430\\u0434\\u0438\\u044f \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442 proposal/design/\\u0432\\u0441\\u0435 specs/**/spec.md; \\u043f\\u043b\\u0430\\u043d\\u043e\\u0432\\u0430\\u044f \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 tasks. State, review, \\u0432\\u043d\\u0435\\u0448\\u043d\\u0438\\u0435 \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a\\u0438 \\u0438 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0438 \\u043b\\u0438\\u043d\\u0437 \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u044b. \\u0421\\u043d\\u0438\\u043c\\u043e\\u043a \\u0434\\u043e/\\u043f\\u043e\\u0441\\u043b\\u0435 \\u0438 \\u0442\\u0435\\u043a\\u0443\\u0449\\u0438\\u0439 \\u0434\\u043e\\u043b\\u0436\\u043d\\u044b \\u0441\\u043e\\u0432\\u043f\\u0430\\u0441\\u0442\\u044c; \\u0433\\u043e\\u043d\\u043a\\u0430 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430 \\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u043e\\u0442\\u0447\\u0435\\u0442 stale \\u0434\\u0430\\u0436\\u0435 \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u044b\\u0445 \\u0431\\u0430\\u0439\\u0442\\u043e\\u0432. \\u0421\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u043d\\u043e\\u0435 freshness \\u2014 \\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435, \\u043f\\u0440\\u0438 \\u0447\\u0442\\u0435\\u043d\\u0438\\u0438 \\u0432\\u044b\\u0447\\u0438\\u0441\\u043b\\u0438\\u0442\\u0435 \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432\\u043d\\u043e\\u0432\\u044c. \\u0418\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0431\\u0449\\u0435\\u0433\\u043e \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430 \\u0443\\u0441\\u0442\\u0430\\u0440\\u0435\\u0432\\u0430\\u0435\\u0442 \\u0434\\u043b\\u044f \\u0432\\u0441\\u0435\\u0445 \\u043b\\u0438\\u043d\\u0437 \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0438\\u043d\\u0434\\u0435\\u043a\\u0441 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u0442\\u044c \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u044e\\u0449\\u0443\\u044e \\u043b\\u0438\\u043d\\u0437\\u0443 \\u043d\\u0435\\u0437\\u0430\\u0432\\u0438\\u0441\\u0438\\u043c\\u043e \\u043e\\u0442 \\u0445\\u0435\\u0448\\u0435\\u0439.\\n\\n\\u0421\\u0432\\u043e\\u0434\\u043a\\u0430 `review/summary.md`: \\u043e\\u0431\\u0449\\u0438\\u0439 frontmatter document_type: summary \\u043f\\u043b\\u044e\\u0441 findings \\u2014 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a `{finding, related_to, duplicates}` \\u0441 \\u043f\\u043e\\u043b\\u043d\\u044b\\u043c\\u0438 \\u043a\\u043b\\u044e\\u0447\\u0430\\u043c\\u0438. \\u0414\\u043b\\u044f \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0445 \\u0441\\u0432\\u044f\\u0437\\u0435\\u0439 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0439\\u0442\\u0435 []. \\u0421\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u0439\\u0442\\u0435 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043e\\u0442\\u0447\\u0435\\u0442\\u044b; \\u043e\\u0431\\u044a\\u0435\\u0434\\u0438\\u043d\\u044f\\u0439\\u0442\\u0435 \\u0434\\u0443\\u0431\\u043b\\u0438 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432 \\u0441\\u0432\\u043e\\u0434\\u043a\\u0435, \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0439\\u0442\\u0435 \\u0440\\u0430\\u0441\\u0