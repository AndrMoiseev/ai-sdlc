{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDD project settings v1",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "object",
          "propertyNames": {"enum": ["sdd-spec.architect", "sdd-spec.explorer", "sdd-apply.explorer", "sdd-spec.reviewer", "sdd-spec.editor", "sdd-apply.executor", "sdd-apply.reviewer"]},
          "additionalProperties": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
        }
      }
    }
  },
  "additionalProperties": true
}
